# Example environment file -- PLACEHOLDERS ONLY.
#
# Copy to `.env` and fill in your own values. `.env` is git-ignored and must
# never be committed. Never paste real keys into this example file.
#
# Nothing in Phase 1 requires any of these: the Yahoo/yfinance development
# provider needs no credentials. They are listed so the Phase 2 Alpaca
# adapter has a documented, code-free home for its configuration.

# --- Alpaca (PAPER TRADING ONLY -- this project never trades real money) ---
ALPACA_API_KEY_ID=your-paper-key-id-here
ALPACA_API_SECRET_KEY=your-paper-secret-key-here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# Free-tier data feed is "iex"; "sip" requires a paid subscription.
ALPACA_DATA_FEED=iex
