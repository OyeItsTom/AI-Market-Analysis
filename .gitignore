# Python virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / API keys
.env
.env.local
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Market data stored locally
data/raw/*
data/processed/*

# Locally ingested news, filings and the cached SEC ticker map. Downloaded
# third-party content must never be committed.
data/news/

# Locally ingested external feed entries and their transport checkpoints.
# Downloaded third-party content must never be committed.
data/feeds/

# Your own feed list. Ignored because it names the sites this machine will
# fetch, which is local configuration rather than project code. The committed
# config/external_feeds.example.json shows the format.
config/external_feeds.local.json

# Keep empty data folders in Git
!data/raw/.gitkeep
!data/processed/.gitkeep

# macOS
.DS_Store

# VS Code local settings
.vscode/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/
